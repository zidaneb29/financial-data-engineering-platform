# Set values in the shell or a local runner. The CLI reads environment variables.
# Request your own FRED application key.
FRED_API_KEY=
# Use an application name followed by a monitored contact email.
SEC_USER_AGENT=
# Keep generated files in the ignored local directory.
FIN_DATA_DIR=.local/data
# Cloud commands only. Configure an approved existing AWS profile locally.
AWS_PROFILE=
AWS_REGION=
FIN_S3_BUCKET=
FIN_ARCHIVE_NAMESPACE=
# AWS Ohio Enterprise trial. Fill credentials locally only after demo setup approval.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_DATABASE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
SNOWFLAKE_PRIVATE_KEY_FILE=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
